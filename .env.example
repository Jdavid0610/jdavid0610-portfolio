# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/next_stack"

# --- Auth -----------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Public ---------------------------------------------------------------
# Used as metadataBase: canonical URLs, OG images, sitemap entries.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OAuth (optional) -----------------------------------------------------
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- Mock backend ---------------------------------------------------------
# `on` runs the app entirely on in-memory fixtures: no Postgres, no auth
# provider. DATABASE_URL becomes optional. Use `pnpm dev:mock` for a one-off.
NEXT_PUBLIC_MOCK_MODE="off"

# Simulated latency in ms, so loading states are real during development.
MOCK_LATENCY_MS="0"

# Comma-separated operations to force-fail, for exercising error states:
# posts.list, posts.create, posts.update, posts.delete, posts.findBySlug,
# auth.signIn, auth.signOut, auth.listUsers, auth.updateProfile
MOCK_FAIL=""

# Refuses to boot a production build with mocks on unless this is "true".
ALLOW_MOCKS_IN_PRODUCTION="false"
